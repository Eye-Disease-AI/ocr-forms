{
  "page": {
    "size": "A4",
    "margin_x_mm": 25,
    "margin_y_mm": 20,
    "font": "/usr/share/fonts/TTF/DejaVuSans.ttf",
    "font_size": 13
  },
  "defaults": {
    "marker_size_mm": 15,
    "marker_pad_mm": 5,
    "char_box_size_mm": 8,
    "question_spacing_mm": 8,
    "label_spacing_mm": 6,
    "bubble_diameter_mm": 6,
    "option_spacing_mm": 8
  },
  "questions": [
    {
      "type": "text",
      "id": "title",
      "label": "Kwestionariusz do badania.",
      "format": ""
    },
    {
      "type": "text",
      "label_spacing_mm": 12,
      "id": "exam_date",
      "label": "Data badania",
      "format": "[2]-[2]-[4]"
    },
    {
      "type": "text",
      "label_spacing_mm": 12,
      "id": "initials",
      "label": "Inicjały (pierwsza litera imienia, pierwsza imienia nazwiska)",
      "format": "[1]    [1]"
    },
    {
      "type": "text",
      "label_spacing_mm": 12,
      "id": "birth_year",
      "label": "Rok urodzenia",
      "format": "[4]"
    },
    {
      "type": "choice",
      "id": "sex",
      "label": "Płeć",
      "direction": "vertical",
      "options": ["Kobieta", "Mężczyzna"]
    },
    {
      "type": "choice",
      "id": "diabetes",
      "label": "Na które z tych chorób wiesz, że chorujesz?",
      "direction": "vertical",
      "options": ["Cukrzyca", "Choroby autoimmunologiczne"]
    },
    {
      "type": "choice",
      "id": "contact_lenses",
      "label": "Czy używasz soczewek kontaktowych?",
      "direction": "vertical",
      "options": ["Nigdy", "W przeszłości", "Obecnie"]
    },
    {
      "type": "choice",
      "id": "eye_surgery_or_trauma",
      "label": "Czy doświadczyłeś/aś operacji oka lub fizycznych urazów oka?",
      "direction": "vertical",
      "options": ["Tak, mniej niż miesiąc temu", "Tak, ponad miesiąc temu", "Nie"]
    },
    {
      "type": "choice",
      "id": "symptoms",
      "label": "Które z tych objawów odczuwasz?",
      "direction": "vertical",
      "options": ["Światłowstręt", "\"Plamka\" w polu widzenia", "Pogorszenie ostrości wzroku", "Zaczerwienienie oka", "Ból oka"]
    },
    {
      "type": "choice",
      "id": "sudden_vision_loss",
      "label": "Kiedy pojawiły się objawy?",
      "direction": "vertical",
      "options": ["Brak", "Ostatnie 24 godziny", "W ostatnim tygodniu", "Dłużej niż tydzień"]
    }
  ]
}